# ── AI Clipping Provider ──────────────────────────────────────────────────────
# Options: groq (recommended, free 14.4k/day) | gemini | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini (Optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama (Optional offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./clipedics.db

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Whisper ───────────────────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Storage & Output ──────────────────────────────────────────────────────────
OUTPUT_DIR=./output
TEMP_DIR=%LOCALAPPDATA%\clipedics\temp

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Auto-detected from PATH or Winget location by default
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
