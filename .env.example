# ── AI Clipping Provider ──────────────────────────────────────────────────────
# Options: groq (recommended, free 14.4k/day) | gemini | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini (Optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama (Optional offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./clipedics.db
# Postgres example:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/clipedics

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Whisper ───────────────────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Leave blank — auto-detected from winget install path on Windows
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# ── Stripe Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# ── AWS S3 Storage (optional — uses local disk by default) ───────────────────
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=clipedics-videos
CDN_BASE_URL=https://d1234abcd.cloudfront.net

# ── Social Publishing OAuth ───────────────────────────────────────────────────
# YouTube (Google Cloud Console → OAuth 2.0)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok (TikTok for Developers → App)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram / Meta (Meta Developer → App)
META_APP_ID=
META_APP_SECRET=

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
